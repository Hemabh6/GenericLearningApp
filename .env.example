# Copy to .env beside compose.yaml and fill in before the first `docker compose up -d`.
POSTGRES_PASSWORD=change-me-to-something-long
# Your domain, so Caddy can issue a certificate. Leave as :80 while testing on an IP.
SITE_ADDRESS=:80
# The super admin account: it can never be removed or demoted from the admin area.
# SUPERADMIN_PASSWORD is only used to CREATE the account on first start (so nobody can register
# that email first); after that, change it from Account > Manage and clear it here.
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=change-me-to-a-strong-password
# Optional "Sign in with Google / Microsoft". Leave blank to hide those buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
